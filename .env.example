# Copy to .env and fill in the secrets. Never commit .env.

# Required
OPENAI_API_KEY=sk-your-openai-key
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key

# Optional (defaults shown)
# The public host is allowed only with synthetic data; APP_ENV=production rejects it.
LANGFUSE_HOST=https://cloud.langfuse.com
# development | staging | production
APP_ENV=development
VISION_MODEL=gpt-4o
CONTEXTUALIZATION_MODEL=gpt-4o
EXTRACTION_MODEL=gpt-4o
# 0-2
LLM_TEMPERATURE=0.0
# low | high | auto
VISION_DETAIL=high
LLM_TIMEOUT_SECONDS=60
# Transport retries per logical invocation, 0-10
LLM_MAX_RETRIES=2
# Must be >= LLM_TIMEOUT_SECONDS
PIPELINE_TIMEOUT_SECONDS=300
MAX_IMAGE_BYTES=10000000
MIN_IMAGE_SIDE_PX=600
# Must be >= MIN_IMAGE_SIDE_PX
MAX_IMAGE_SIDE_PX=4096
MAX_IMAGE_PIXELS=16777216
# Absolute [ILLEGIBLE] count per page that triggers IllegibleDocumentError
ILLEGIBLE_MAX_MARKS=10
PARSE_CACHE_DIR=.cache/parsed
# Leave unset for the APP_ENV default: true in development, false in production
# PARSE_CACHE_ENABLED=
PARSE_CACHE_TTL_HOURS=24
LOG_LEVEL=INFO

# Optional: evals only (read by EvalSettings in evals/, not by the runtime Settings)
# Must differ from EXTRACTION_MODEL
# JUDGE_MODEL=gpt-4.1
